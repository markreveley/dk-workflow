# Dan Koe Content Workflow - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_NAME=content_workflow
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# For Airtable (alternative to PostgreSQL)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_base_id

# ============================================================================
# LETTA CONFIGURATION
# ============================================================================
LETTA_SERVER_URL=http://localhost:8283
LETTA_API_KEY=your_letta_api_key

# Agent IDs (will be populated after agent creation)
AGENT_CONTENT_GENERATION_ID=
AGENT_CONTENT_STRATEGIST_ID=
AGENT_RESEARCH_SYNTHESIS_ID=
AGENT_REPURPOSING_ID=
AGENT_PERFORMANCE_ANALYSIS_ID=

# ============================================================================
# LLM API KEYS
# ============================================================================

# Anthropic Claude (recommended for long context)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini (for long video transcripts)
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-1.5-pro

# ============================================================================
# PLATFORM API KEYS
# ============================================================================

# Twitter/X API v2
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# Email Platform (choose one)
# ConvertKit
CONVERTKIT_API_KEY=your_convertkit_api_key
CONVERTKIT_API_SECRET=your_convertkit_api_secret

# Beehiiv
BEEHIIV_API_KEY=your_beehiiv_api_key
BEEHIIV_PUBLICATION_ID=your_publication_id

# ============================================================================
# SOCIAL MEDIA SCHEDULING (optional)
# ============================================================================

# Buffer
BUFFER_ACCESS_TOKEN=your_buffer_access_token

# Hootsuite
HOOTSUITE_ACCESS_TOKEN=your_hootsuite_access_token

# ============================================================================
# NOTIFICATION SERVICES
# ============================================================================

# Slack (for alerts and approvals)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL_REVIEWS=#content-review
SLACK_CHANNEL_ALERTS=#alerts

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=your_email@gmail.com

# ============================================================================
# N8N CONFIGURATION
# ============================================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password

# Webhook URLs (will be generated by n8n)
N8N_WEBHOOK_URL_BASE=http://localhost:5678/webhook
WEBHOOK_CONTENT_APPROVAL=
WEBHOOK_NEWSLETTER_COMPLETE=
WEBHOOK_IDEA_VALIDATION=

# ============================================================================
# WORKFLOW SETTINGS
# ============================================================================

# Content ratios
EXPERIMENTAL_RATIO=0.7
PROVEN_RATIO=0.3

# Publishing schedule (cron expressions)
DAILY_CONTENT_SCHEDULE="0 6 * * *"  # 6 AM daily
NEWSLETTER_SCHEDULE="0 8 * * 1"     # 8 AM every Monday
PERFORMANCE_CHECK_SCHEDULE="0 23 * * *"  # 11 PM daily

# Performance thresholds
VALIDATION_ENGAGEMENT_THRESHOLD=5.0  # 5% engagement rate
MIN_LIKES_FOR_VALIDATION=100
PLATEAU_DETECTION_THRESHOLD=0.8  # 80% of historical average

# Content limits
MAX_IDEAS_BACKLOG=100
MAX_QUEUE_SIZE=50
RESEARCH_SUMMARY_WORD_COUNT=1000

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_AUTO_PUBLISHING=false  # Set to true for full automation
ENABLE_AUTO_VALIDATION=true
ENABLE_PERFORMANCE_TRACKING=true
ENABLE_RESEARCH_AUTO_PROCESSING=false

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE_PATH=./logs/workflow.log

# Sentry (optional error tracking)
SENTRY_DSN=

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG_MODE=true
DRY_RUN_MODE=false  # If true, don't actually post/publish
